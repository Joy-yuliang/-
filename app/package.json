{
  "name": "personal-tixi",
  "productName": "个人体系",
  "version": "0.2.0",
  "description": "个人生活体系软件（每日页 + 日记页）",
  "author": "Personal",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "app": "vite build && electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "docx": "^9.2.0",
    "dompurify": "^3.4.13",
    "lunar-javascript": "^1.6.12",
    "marked": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.personal.tixi",
    "productName": "个人体系",
    "files": [
      "dist/**",
      "src/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "个人体系.exe"
    }
  }
}
